#!/usr/bin/env bash
# =============================================================================
# pulse - day-to-day operations for the PulseDeploy Laravel + Next.js server
#   pulse deploy <api|admin|shop> --artifact FILE.tar.gz | --git URL [--ref REF]
#   pulse rollback <api|admin|shop>
#   pulse status | logs <target> | backup | restore FILE --yes | help
# Config: /etc/pulsedeploy/pulse.conf (written by the installer)
# =============================================================================
set -Eeuo pipefail

PULSE_CONF="${PULSE_CONF:-/etc/pulsedeploy/pulse.conf}"
# shellcheck source=/dev/null
[[ -r "$PULSE_CONF" ]] && source "$PULSE_CONF"

APP_USER="${APP_USER:-deploy}"
APPS_ROOT="${APPS_ROOT:-/var/www}"
API_HOST="${API_HOST:-}"
ADMIN_HOST="${ADMIN_HOST:-}"
SHOP_HOST="${SHOP_HOST:-}"
ADMIN_PORT="${ADMIN_PORT:-3001}"
SHOP_PORT="${SHOP_PORT:-3000}"
PHP_BIN="${PHP_BIN:-php}"
PHP_FPM_SVC="${PHP_FPM_SVC:-php-fpm}"
KEEP_RELEASES="${KEEP_RELEASES:-5}"
DB_NAME="${DB_NAME:-}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/pulsedeploy}"
BACKUP_KEEP_DAYS="${BACKUP_KEEP_DAYS:-7}"
BACKUP_FILES="${BACKUP_FILES:-1}"
RCLONE_REMOTE="${RCLONE_REMOTE:-}"
HEALTHCHECK_URL="${HEALTHCHECK_URL:-}"
QUEUE_ENABLED="${QUEUE_ENABLED:-1}"
SCHEDULER_ENABLED="${SCHEDULER_ENABLED:-1}"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BOLD=''; RESET=''
fi
say()  { printf '%s\n' "${GREEN}[ok]${RESET} $*"; }
note() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "${YELLOW}[warn]${RESET} $*" >&2; }
die()  { printf '%s\n' "${RED}[error]${RESET} $*" >&2; exit 1; }

trap 'die "failed at line $LINENO: $BASH_COMMAND"' ERR

# ── helpers ───────────────────────────────────────────────────────────────────
valid_app() { [[ "$1" == "api" || "$1" == "admin" || "$1" == "shop" ]]; }

app_host() {
  case "$1" in api) echo "$API_HOST" ;; admin) echo "$ADMIN_HOST" ;; shop) echo "$SHOP_HOST" ;; esac
}
app_port() {
  case "$1" in admin) echo "$ADMIN_PORT" ;; shop) echo "$SHOP_PORT" ;; esac
}

# Run systemctl, through sudo when not root. Unit names carry the .service
# suffix so they match the sudoers entries the installer writes.
svc() {
  if [[ $EUID -eq 0 ]]; then systemctl "$@"; else sudo -n systemctl "$@"; fi
}

app_dir()      { echo "$APPS_ROOT/$1"; }
releases_dir() { echo "$APPS_ROOT/$1/releases"; }

current_release() {
  local link="$APPS_ROOT/$1/current"
  [[ -L "$link" ]] || return 0
  basename "$(readlink -f "$link")"
}

# Release names sort chronologically (timestamps); placeholder sorts first.
list_releases() {
  local dir
  dir="$(releases_dir "$1")"
  [[ -d "$dir" ]] || return 0
  find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

switch_release() { # atomic symlink swap
  local app="$1" rel="$2" base
  base="$(app_dir "$app")"
  ln -sfn "$base/releases/$rel" "$base/current.tmp"
  mv -Tf "$base/current.tmp" "$base/current"
}

prune_releases() {
  local app="$1" cur total drop
  cur="$(current_release "$app")"
  total="$(list_releases "$app" | wc -l)"
  ((total > KEEP_RELEASES)) || return 0
  drop=$((total - KEEP_RELEASES))
  local rel target
  while read -r rel; do
    ((drop > 0)) || break
    [[ -n "$rel" && "$rel" != "$cur" ]] || continue
    target="$(releases_dir "$app")/$rel"
    # Only ever delete a direct child of <apps>/<app>/releases/
    [[ "$target" == "$APPS_ROOT/$app/releases/"?* && "$rel" != */* ]] || continue
    rm -rf -- "${target:?}"
    drop=$((drop - 1))
  done < <(list_releases "$app")
}

# HTTP status of the app as nginx would serve it (Host header on localhost)
http_code() {
  local host="$1" code
  code="$(curl -s -o /dev/null -m 10 -w '%{http_code}' -H "Host: $host" "http://127.0.0.1/" 2>/dev/null)" || code="000"
  echo "$code"
}

# Healthy = the app answers with anything below 500 (a Laravel 404 still
# means PHP is running; 502/503 or no answer means it is not).
wait_healthy() {
  local app="$1" host code
  host="$(app_host "$app")"
  [[ -n "$host" ]] || { warn "no host configured for $app; skipping health check"; return 0; }
  for _ in $(seq 1 20); do
    code="$(http_code "$host")"
    if [[ "$code" =~ ^[1-4][0-9][0-9]$ ]]; then
      say "$app healthy (HTTP $code)"
      return 0
    fi
    sleep 1
  done
  return 1
}

activate() { # activate <app>: make the running services pick up the new release
  local app="$1"
  case "$app" in
    api)
      svc reload "${PHP_FPM_SVC}.service"
      if [[ "$QUEUE_ENABLED" == "1" ]]; then
        svc restart pulse-queue.service || warn "queue worker not restarted"
      fi
      if [[ "$SCHEDULER_ENABLED" == "1" ]]; then
        svc start pulse-scheduler.timer || warn "scheduler timer not started"
      fi
      ;;
    admin|shop) svc restart "pulse-next@${app}.service" ;;
  esac
}

# ── deploy ────────────────────────────────────────────────────────────────────
PENDING_RELEASE=""
cleanup_pending() {
  if [[ -n "$PENDING_RELEASE" && -d "$PENDING_RELEASE" ]]; then
    rm -rf -- "${PENDING_RELEASE:?}"
    warn "deploy failed: removed the incomplete release; the previous release is still live"
  fi
}

cmd_deploy() {
  local app="${1:-}" artifact="" git_url="" ref="main" migrate=1
  valid_app "$app" || die "usage: pulse deploy <api|admin|shop> --artifact FILE | --git URL [--ref REF] [--no-migrate]"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --artifact) artifact="${2:-}"; shift 2 ;;
      --git)      git_url="${2:-}";  shift 2 ;;
      --ref)      ref="${2:-}";      shift 2 ;;
      --no-migrate) migrate=0;       shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -n "$artifact" || -n "$git_url" ]] || die "give --artifact FILE.tar.gz or --git URL"
  [[ -z "$artifact" || -f "$artifact" ]] || die "artifact not found: $artifact"
  [[ -z "$git_url" || "$app" == "api" ]] || die "--git is only supported for api; build $app in CI and pass --artifact"
  [[ -d "$(app_dir "$app")" ]] || die "$(app_dir "$app") does not exist; run the PulseDeploy installer first"

  local rel dir base prev stamp n=0
  base="$(app_dir "$app")"
  prev="$(current_release "$app")"
  # Unique, sortable release name; mkdir is atomic so two deploys in the same
  # second can never share a directory.
  stamp="$(date +%Y%m%d%H%M%S)"
  rel="$stamp"
  until mkdir "$base/releases/$rel" 2>/dev/null; do
    n=$((n + 1))
    ((n < 100)) || die "could not create a release directory in $base/releases"
    rel="${stamp}-$(printf '%02d' "$n")"
  done
  dir="$base/releases/$rel"
  # Whatever goes wrong before the switch, do not leave a half-built release.
  PENDING_RELEASE="$dir"
  trap 'cleanup_pending' EXIT

  note "Deploying $app as release $rel"
  if [[ -n "$artifact" ]]; then
    tar -xzf "$artifact" -C "$dir"
  else
    git clone --quiet --depth 1 --branch "$ref" "$git_url" "$dir"
    rm -rf "$dir/.git"
  fi

  if [[ "$app" == "api" ]]; then
    prepare_api "$dir" "$base" "$migrate" "$([[ -n "$git_url" ]] && echo 1 || echo 0)"
  else
    prepare_next "$dir" "$base"
  fi

  switch_release "$app" "$rel"
  PENDING_RELEASE="" # live now: a later failure rolls back instead of deleting

  if ! { activate "$app" && wait_healthy "$app"; }; then
    warn "health check failed, rolling back"
    if [[ -n "$prev" ]]; then
      switch_release "$app" "$prev"
      activate "$app" || true
      die "rolled back to $prev; the failed release is kept at $dir for inspection"
    fi
    die "health check failed and there is no previous release to roll back to"
  fi
  prune_releases "$app"
  say "$app deployed: $rel"
}

prepare_api() { # prepare_api <dir> <base> <migrate> <composer>
  local dir="$1" base="$2" migrate="$3" composer="$4"
  [[ -f "$dir/artisan" && -f "$dir/public/index.php" ]] || die "not a Laravel app (artisan or public/index.php missing)"

  if [[ "$composer" == "1" ]]; then
    command -v composer >/dev/null || die "composer is not installed"
    (cd "$dir" && composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction --no-progress)
  fi
  [[ -f "$dir/vendor/autoload.php" ]] || die "vendor/ is missing: build with 'composer install --no-dev' in CI, or deploy with --git"

  # Persistent state lives in shared/
  ln -sfn "$base/shared/.env" "$dir/.env"
  rm -rf "$dir/storage"
  ln -sfn "$base/shared/storage" "$dir/storage"
  mkdir -p "$dir/bootstrap/cache"

  if ! grep -q '^APP_KEY=base64:' "$base/shared/.env"; then
    (cd "$dir" && "$PHP_BIN" artisan key:generate --force --no-interaction)
    say "generated APP_KEY"
  fi
  if [[ "$migrate" == "1" ]]; then
    (cd "$dir" && "$PHP_BIN" artisan migrate --force --no-interaction)
  fi
  if ! (cd "$dir" && "$PHP_BIN" artisan storage:link --force --no-interaction >/dev/null 2>&1); then
    warn "storage:link did not run (older Laravel?); continuing"
  fi
  (cd "$dir" && "$PHP_BIN" artisan optimize --no-interaction)
}

prepare_next() { # prepare_next <dir> <base>
  local dir="$1" base="$2"
  [[ -f "$dir/server.js" ]] || die "server.js not found at the artifact root. Package the standalone output: server.js, .next/, public/, node_modules/ (see docs)"
  [[ -d "$dir/.next/static" ]] || warn "no .next/static in the artifact; pages will load without CSS/JS"
  mkdir -p "$base/shared/next-cache" "$dir/.next"
  rm -rf "$dir/.next/cache"
  ln -sfn "$base/shared/next-cache" "$dir/.next/cache"
}

# ── rollback ──────────────────────────────────────────────────────────────────
cmd_rollback() {
  local app="${1:-}" cur prev="" rel
  valid_app "$app" || die "usage: pulse rollback <api|admin|shop>"
  cur="$(current_release "$app")"
  [[ -n "$cur" ]] || die "$app has no current release"
  while read -r rel; do
    [[ "$rel" == "$cur" ]] && break
    prev="$rel"
  done < <(list_releases "$app")
  [[ -n "$prev" ]] || die "no earlier release to roll back to"
  switch_release "$app" "$prev"
  activate "$app"
  wait_healthy "$app" || warn "the rolled-back release did not pass the health check"
  say "$app rolled back: $cur -> $prev"
}

# ── status / logs ─────────────────────────────────────────────────────────────
cmd_status() {
  local unit db_svc
  db_svc=""
  for unit in mysql mysqld mariadb; do
    systemctl cat "$unit.service" &>/dev/null && { db_svc="$unit"; break; }
  done
  note "${BOLD}Services${RESET}"
  for unit in nginx "$PHP_FPM_SVC" "$db_svc" redis-server redis pulse-next@admin pulse-next@shop pulse-queue pulse-scheduler.timer; do
    [[ -n "$unit" ]] || continue
    if [[ "$unit" == *.timer ]]; then
      systemctl cat "$unit" &>/dev/null || continue
    else
      systemctl cat "$unit.service" &>/dev/null || continue
    fi
    printf '  %-28s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
  done
  note "${BOLD}Apps${RESET}"
  local app
  for app in api admin shop; do
    printf '  %-6s release %-16s http %s  %s\n' "$app" "$(current_release "$app")" \
      "$(http_code "$(app_host "$app")")" "$(app_host "$app")"
  done
  note "${BOLD}Resources${RESET}"
  free -m | awk 'NR==1 || /^Mem|^Swap/ { print "  " $0 }'
  df -h / | awk 'NR==2 { printf "  disk / : %s used of %s (%s)\n", $3, $2, $5 }'
  note "${BOLD}Backups${RESET}"
  local last
  if [[ -r "$BACKUP_DIR" ]]; then
    last="$(find "$BACKUP_DIR" -name 'db-*.sql.gz' -printf '%T@ %f\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)" || last=""
    printf '  latest database backup: %s\n' "${last:-none yet}"
  else
    printf '  latest database backup: (directory is root-only; run "sudo pulse status")\n'
  fi
}

cmd_logs() {
  local target="${1:-}" follow="" lines=100
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in -f) follow="-f"; shift ;; -n) lines="${2:-100}"; shift 2 ;; *) die "unknown option: $1" ;; esac
  done
  case "$target" in
    admin|shop) journalctl -u "pulse-next@${target}.service" -n "$lines" --no-pager $follow ;;
    queue)      journalctl -u pulse-queue.service -n "$lines" --no-pager $follow ;;
    scheduler)  journalctl -u pulse-scheduler.service -n "$lines" --no-pager $follow ;;
    php)        journalctl -u "${PHP_FPM_SVC}.service" -n "$lines" --no-pager $follow ;;
    nginx)      tail -n "$lines" $follow /var/log/nginx/error.log ;;
    api)
      local log
      log="$(find "$APPS_ROOT/api/shared/storage/logs" -name '*.log' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)" || log=""
      [[ -n "$log" ]] || die "no Laravel log files yet"
      tail -n "$lines" $follow "$log"
      ;;
    *) die "usage: pulse logs <api|admin|shop|queue|scheduler|php|nginx> [-f] [-n LINES]" ;;
  esac
}

# ── backup / restore ──────────────────────────────────────────────────────────
ping_hc() { # ping_hc <suffix, may be empty>
  [[ -n "$HEALTHCHECK_URL" ]] || return 0
  curl -fsS -m 10 --retry 3 -o /dev/null "${HEALTHCHECK_URL}${1}" || true
}

cmd_backup() {
  [[ $EUID -eq 0 ]] || die "run as root: sudo pulse backup"
  [[ -n "$DB_NAME" ]] || die "DB_NAME is not set in $PULSE_CONF"
  trap 'ping_hc /fail; die "backup failed at line $LINENO: $BASH_COMMAND"' ERR
  local stamp out
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  out="$BACKUP_DIR/db-$DB_NAME-$stamp.sql.gz"
  (umask 077; mysqldump --single-transaction --quick --routines --triggers --events "$DB_NAME" | gzip -9 >"$out")
  gzip -t "$out"
  [[ "$(stat -c %s "$out")" -gt 100 ]] || die "database dump looks empty: $out"
  say "database backup: $out ($(du -h "$out" | cut -f1))"

  if [[ "$BACKUP_FILES" == "1" && -d "$APPS_ROOT/api/shared/storage/app" ]]; then
    (umask 077; tar -C "$APPS_ROOT/api/shared/storage" -czf "$BACKUP_DIR/files-$stamp.tar.gz" app)
    say "uploads backup: $BACKUP_DIR/files-$stamp.tar.gz"
  fi

  find "$BACKUP_DIR" -type f \( -name 'db-*.sql.gz' -o -name 'files-*.tar.gz' \) -mtime "+$BACKUP_KEEP_DAYS" -delete

  if [[ -n "$RCLONE_REMOTE" ]]; then
    if command -v rclone >/dev/null; then
      rclone copy "$BACKUP_DIR" "$RCLONE_REMOTE" --max-age 2d --quiet && say "copied to $RCLONE_REMOTE"
    else
      warn "RCLONE_REMOTE is set but rclone is not installed"
    fi
  fi
  ping_hc ""
}

cmd_restore() {
  local file="${1:-}" yes="${2:-}"
  [[ $EUID -eq 0 ]] || die "run as root: sudo pulse restore FILE --yes"
  [[ -f "$file" ]] || die "usage: pulse restore <db-backup.sql.gz> --yes"
  [[ "$yes" == "--yes" ]] || die "restore OVERWRITES database '$DB_NAME'. Re-run with --yes to confirm."
  gzip -t "$file"
  gunzip -c "$file" | mysql "$DB_NAME"
  say "restored $file into $DB_NAME"
}

cmd_help() {
  cat <<EOF
${BOLD}pulse${RESET} - operations for the Laravel + Next.js server

  pulse deploy api   --artifact app.tar.gz | --git URL [--ref main] [--no-migrate]
  pulse deploy admin --artifact admin.tar.gz
  pulse deploy shop  --artifact shop.tar.gz
  pulse rollback <api|admin|shop>
  pulse status
  pulse logs <api|admin|shop|queue|scheduler|php|nginx> [-f] [-n LINES]
  sudo pulse backup
  sudo pulse restore FILE.sql.gz --yes

Next.js artifacts: tar the standalone output so server.js, .next/, public/ and
node_modules/ sit at the archive root. Config: $PULSE_CONF
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    deploy)   cmd_deploy "$@" ;;
    rollback) cmd_rollback "$@" ;;
    status)   cmd_status ;;
    logs)     cmd_logs "$@" ;;
    backup)   cmd_backup ;;
    restore)  cmd_restore "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$cmd' (try: pulse help)" ;;
  esac
}

main "$@"
